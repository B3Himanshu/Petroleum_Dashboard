# Dev (recommended for Cloudflare tunnel + phone): leave VITE_API_URL unset or empty.
# The app calls /api on the same host; Vite proxies to http://127.0.0.1:2000 — no second tunnel, no CORS issues.
#
# Only set VITE_API_URL if the API is on another origin (e.g. different machine or preview without proxy):
# VITE_API_URL=https://your-backend.trycloudflare.com

# ─────────────────────────────────────────────────────────────────────────────
# Subpath deploy (e.g. dashboard.credentia.biz/hsrl, dashboard.credentia.biz/prl)
# Leave empty or "/" for root deployment (local dev, standalone).
# Set to "/hsrl" (no trailing slash) when hosted under that path.
# Used by: Vite base URL, React Router basename, API client prefix.
# Can also be set in backend/.env as BASE_PATH (frontend reads from there too).
# ─────────────────────────────────────────────────────────────────────────────
# VITE_BASE_PATH=/hsrl
#
# Tunnel host for Vite allowedHosts is read from ../backend/.env → DEV_TUNNEL_HOST (optional).
#
# Site Comparison — Google map imagery (Static Maps + Street View + optional embed).
# Create a key in Google Cloud Console; enable "Maps Static API" and "Street View Static API".
# Restrict the key by HTTP referrer to your app URL(s).
# VITE_GOOGLE_MAPS_API_KEY=
