# Copy to .env and fill in real values. Never commit .env

# Option 1: Single connection string (URL-encode password if it has special chars)
# DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DB_NAME

# Option 2: Separate variables
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=petroleum_db
# DB_USER=your_user
# DB_PASSWORD=your_password

# Optional: schema for transactions table (e.g. sage_data)
# DB_TRANSACTIONS_SCHEMA=sage_data
# DB_SEARCH_PATH=sage_data,public

PORT=2000
NODE_ENV=development
FRONTEND_URL=http://localhost:9090
