# Copy to .env and fill in values.

# Database (existing app)
# DATABASE_URL=postgresql://...
# Or: DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD

# Auth — required in production
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Admin login for /admin/login (saved to DB on server start, or run: npm run sync-admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password

# Legacy names (optional — used if ADMIN_* not set)
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# Default: users must verify email before dashboard login. Set to 0/false to skip (local dev only).
# AUTH_REQUIRE_EMAIL_VERIFIED=0

# Email (verification + password reset). Without SMTP_HOST, nothing is delivered to inboxes.
# Dev: backend returns verificationUrl in admin API JSON + UI toast when NODE_ENV !== production.
# Gmail: use an App Password, not your normal password (2FA required).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=your@email.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM=your@email.com

# Optional: include verificationUrl in admin API even in production (debug only)
# EMAIL_DEV_RETURN_LINK=1

# Used in email links (no trailing slash) — must match how users open the app
# Local: http://localhost:8080
# Cloudflare quick tunnel: https://xxxxx.trycloudflare.com (update when tunnel URL changes)
# Subpath deploy: https://dashboard.credentia.biz/hsrl  (full URL including the prefix)
FRONTEND_URL=http://localhost:8080

# Optional: extra browser origins allowed by CORS (comma-separated). Use if the UI origin must be
# listed explicitly (e.g. multiple domains). Browser Origin has no path — subpath FRONTEND_URL is
# matched automatically via origin, but you can still set:
# CORS_ALLOWED_ORIGINS=https://dashboard.credentia.biz

# ─────────────────────────────────────────────────────────────────────────────
# Subpath deploy — set when the app is hosted under a URL prefix.
# Examples: /hsrl, /prl. Leave empty or "/" for root deployment.
# Frontend (Vite) reads this at build time and applies it to:
#   - Vite `base` (asset URLs)
#   - React Router `basename` (all routes)
#   - API client (so /api/* becomes /hsrl/api/*)
# ─────────────────────────────────────────────────────────────────────────────
# BASE_PATH=/hsrl

# Optional: same public URL as FRONTEND_URL when using Cloudflare Tunnel (explicit CORS entry)
# DEV_TUNNEL_HOST=https://xxxxx.trycloudflare.com

# UI: set false to hide the Dark UI switch in the dashboard header (read at runtime via GET /api/ui-config).
# DARK_MODE_TOGGLE=false

# Server / CORS (existing)
# PORT=2000
# FRONTEND_URL=http://localhost:9090
